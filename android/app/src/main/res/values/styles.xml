<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Matches the app background so no white flash appears in dark mode. -->
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Android 12+ launch screen: the app icon on this color. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
    </style>

</resources>
